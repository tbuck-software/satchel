{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "compose",
  "description": "Standalone composer popouts. `allow-destroy` is what lets the close guard save the draft and only then tear the window down; the main window composes inline and never destroys itself, so `default.json` stays without it.",
  "windows": [
    "compose-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "allow-app-commands",
    "fs:deny-default",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/satchel/attachments/**",
        "$APPCACHE/satchel-transfer-*"
      ],
      "deny": [
        "$APPDATA/satchel/.env",
        "$APPDATA/satchel/pgp-master-key-v1",
        "$APPDATA/satchel/crypto/**",
        "$APPDATA/satchel/satchel.db*",
        "$APPDATA/satchel/plugins/**",
        "$APPCACHE/satchel/wasmtime/**"
      ]
    }
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ]
}
