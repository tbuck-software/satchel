{
  "name": "satchel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_SATCHEL_MOCK=1 vite",
    "build": "vue-tsc -b && vite build",
    "bundle:check": "node ./scripts/check-entry-bundles.mjs",
    "plugin": "node ./scripts/plugin.mjs",
    "plugin:create": "node ./scripts/create-plugin.mjs",
    "plugin:sign": "node ./scripts/sign-plugin.mjs",
    "plugin:simulate": "node ./scripts/plugin-simulate.mjs",
    "plugins:build": "node ./scripts/build-plugins.mjs --release",
    "plugins:build:debug": "node ./scripts/build-plugins.mjs",
    "ipc:generate": "node ./scripts/ipc-generate.mjs",
    "ipc:check": "node ./scripts/ipc-generate.mjs --check",
    "check": "pnpm run ipc:check && pnpm run lint && pnpm run scripts:any:check && pnpm run i18n:check && pnpm exec vue-tsc -b && vitest run && cargo test -p satchel -p satchel-core --quiet && pnpm run test:smoke && pnpm run test:csp",
    "i18n:build": "node ./scripts/i18n-merge.mjs",
    "i18n:extract": "node ./scripts/i18n-extract.mjs",
    "i18n:check": "node ./scripts/i18n-merge.mjs --check && node ./scripts/i18n-extract.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "playwright test --config tests/playwright.smoke.config.ts",
    "test:csp": "pnpm run build && playwright test --config tests/playwright.csp.config.ts",
    "fonts:vendor": "node ./scripts/vendor-fonts.mjs",
    "tauri:dev": "pnpm run plugins:build:debug && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "pnpm run plugins:build && tauri build",
    "tauri:install": "pnpm run plugins:build && tauri build --bundles app",
    "tauri:daily": "pnpm run plugins:build && tauri build --config src-tauri/tauri.daily.conf.json --bundles app --no-sign",
    "install:mac": "pnpm run check && node ./scripts/install-mac.mjs --channel stable --open",
    "install:android": "pnpm run check && pnpm run plugins:build && node ./scripts/install-android.mjs --open",
    "install:all": "pnpm run check && node ./scripts/install-mac.mjs --channel stable --open && pnpm run plugins:build && node ./scripts/install-android.mjs --open",
    "install:daily:mac": "pnpm run check && node ./scripts/install-mac.mjs --channel daily --open",
    "import:daily:data": "node ./scripts/import-daily-data.mjs",
    "render:fidelity": "node ./scripts/render-fidelity-check.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "release:mac": "pnpm run release:check && pnpm run tauri:build",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "node ./scripts/dev-android.mjs",
    "tauri:android:build": "tauri android build --apk --aab --ci",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build --ci",
    "lint": "oxlint src scripts tests *.ts",
    "scripts:any:check": "node ./scripts/check-script-implicit-any.mjs",
    "install:nightly": "node ./scripts/install-release.mjs --channel nightly --open",
    "install:stable": "node ./scripts/install-release.mjs --channel stable --open",
    "release:nightly": "gh workflow run release.yml --repo tbuck-software/satchel --ref main -f channel=nightly",
    "release:stable": "gh workflow run release.yml --repo tbuck-software/satchel --ref main -f channel=stable",
    "notices:build": "node ./scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^12.7.0",
    "date-fns": "^4.4.0",
    "marked": "^18.1.1",
    "pinia": "^3.0.1",
    "punycode": "^2.3.1",
    "tldts": "^7.4.18",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.13.4",
    "@types/punycode": "^2.1.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbuck-software/satchel.git"
  }
}
