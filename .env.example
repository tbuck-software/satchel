# Copy to .env and fill in at least one provider client ID.
#
# No redirect URI here on purpose. RFC 8252 asks a native client to take an
# ephemeral loopback port per authorization request, and Satchel does — but a
# value in `SATCHEL_*_REDIRECT_URI` pins the port and switches that off. Set one
# only if your provider registration demands a fixed port.
#
# The client secrets are not compiled into the binary. Set them here only for a
# provider registration that requires them. Personal Android debug installs
# provision these values into private app storage, outside the APK.

# Gmail OAuth
SATCHEL_GMAIL_CLIENT_ID=
SATCHEL_GMAIL_CLIENT_SECRET=

# Outlook OAuth
SATCHEL_OUTLOOK_CLIENT_ID=
SATCHEL_OUTLOOK_CLIENT_SECRET=
